// Cloudflare Python Workers config for the NearMe backend API.
// Local test: uv run pywrangler dev / Deploy: uv run pywrangler deploy
// Keep this file ASCII-only: pywrangler reads it with the OS default encoding (cp949 on Korean Windows).
{
  "name": "nearme-api",
  "main": "src/worker.py",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["python_workers"]
}
